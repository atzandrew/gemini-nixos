+	if ((long)res.a0 < 0 || abs((long)got - (long)rate) > 1000000) {
+		pr_err("clk-mt6797-mcu: armpll_b -> %lu Hz: SMC 0x%lx, PLL now %lu Hz\n",
+		       rate, res.a0, got);
